# Copy to .env on the server. Never commit .env.
N8N_HOST=n8n.example.com
TZ=Asia/Ho_Chi_Minh
# openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -hex 32  -- losing this = losing all stored credentials
N8N_ENCRYPTION_KEY=
# Pin after first pull: docker inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' <container>
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
